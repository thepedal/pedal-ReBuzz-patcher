<UserControl x:Class="PedalPatch.GUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1A1A1A" Foreground="#E0E0E0"
             FontFamily="Segoe UI" FontSize="12">

    <UserControl.Resources>

        <!-- Flat dark button base -->
        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Background"         Value="#2D2D2D"/>
            <Setter Property="Foreground"         Value="#D0D0D0"/>
            <Setter Property="BorderBrush"        Value="#484848"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="Padding"            Value="10 3"/>
            <Setter Property="Height"             Value="24"/>
            <Setter Property="Cursor"             Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E6FBF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#555555"/>
                                <Setter Property="BorderBrush" Value="#333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Matrix cell toggle button -->
        <Style x:Key="CellStyle" TargetType="Button">
            <Setter Property="Width"           Value="48"/>
            <Setter Property="Height"          Value="48"/>
            <Setter Property="Margin"          Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="#88BBFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox override -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="#2D2D2D"/>
            <Setter Property="Foreground"      Value="#D0D0D0"/>
            <Setter Property="BorderBrush"     Value="#484848"/>
            <Setter Property="Height"          Value="24"/>
        </Style>

        <!-- CheckBox override -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground"      Value="#B0B0B0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Slider override -->
        <Style TargetType="Slider">
            <Setter Property="Foreground"  Value="#2277DD"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="Auto"/>   <!-- patch + clipboard bar -->
            <RowDefinition Height="*"/>      <!-- matrix -->
            <RowDefinition Height="Auto"/>   <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ── Row 0: Title bar ─────────────────────────────────────────── -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 8">
            <TextBlock Text="Pedal Patcher" FontSize="14" FontWeight="SemiBold"
                       Foreground="#4499FF" VerticalAlignment="Center"/>
            <TextBlock x:Name="SubTitle" Text="" Foreground="#666666"
                       VerticalAlignment="Center" Margin="6 0 0 0" FontSize="11"/>
        </StackPanel>

        <!-- ── Row 1: Controls ──────────────────────────────────────────── -->
        <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 10">

            <!-- Patch selector -->
            <TextBlock Text="Patch" VerticalAlignment="Center" Margin="0 0 4 0"
                       Foreground="#AAAAAA"/>
            <ComboBox x:Name="PatchCombo" Width="110" Margin="0 0 10 0"
                      SelectionChanged="PatchCombo_SelectionChanged"/>

            <!-- Divider -->
            <Border Width="1" Background="#404040" Margin="4 2 12 2"/>

            <!-- Patch actions -->
            <Button x:Name="BtnCopy"       Content="Copy"        Margin="2 0"
                    Click="Copy_Click"      Style="{StaticResource ToolButtonStyle}"/>
            <Button x:Name="BtnPaste"      Content="Paste"       Margin="2 0"
                    Click="Paste_Click"     Style="{StaticResource ToolButtonStyle}"/>
            <Button x:Name="BtnMerge"      Content="Merge"       Margin="2 0"
                    Click="Merge_Click"     Style="{StaticResource ToolButtonStyle}"/>
            <Button x:Name="BtnClear"      Content="Clear"       Margin="2 0"
                    Click="Clear_Click"     Style="{StaticResource ToolButtonStyle}"/>
            <Button x:Name="BtnClearAll"   Content="Clear All"   Margin="2 0"
                    Click="ClearAll_Click"  Style="{StaticResource ToolButtonStyle}"/>

            <!-- Divider -->
            <Border Width="1" Background="#404040" Margin="12 2 12 2"/>

            <CheckBox x:Name="ChkPreserve" Content="Preserve clipboard" Margin="0 0 0 0"
                      Checked="ChkPreserve_Changed" Unchecked="ChkPreserve_Changed"/>
        </WrapPanel>

        <!-- ── Row 2: Patch matrix ──────────────────────────────────────── -->
        <ScrollViewer Grid.Row="2"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0 0 0 8">
            <Grid x:Name="MatrixGrid" HorizontalAlignment="Left" VerticalAlignment="Top"/>
        </ScrollViewer>

        <!-- ── Row 3: Footer ────────────────────────────────────────────── -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Fade (ms)" VerticalAlignment="Center"
                       Foreground="#AAAAAA" Margin="0 0 8 0"/>
            <Slider   Grid.Column="1" x:Name="FadeSlider" Minimum="0" Maximum="500"
                      VerticalAlignment="Center"
                      ValueChanged="FadeSlider_ValueChanged"/>
            <TextBlock Grid.Column="2" x:Name="FadeLabel" Width="36"
                       VerticalAlignment="Center" Margin="6 0 0 0"
                       Foreground="#D0D0D0"/>
        </Grid>

    </Grid>
</UserControl>
